__pycache__/
*.pyc
# generated: OBJ exports written by scene/spec.py
assets/meshes/
# generated evaluation outputs (rerun the scripts to recreate), except the final sweep's results
output/*
!output/final_sweep/
!output/final_sweep_isaac/
output/final_sweep/screening/*
!output/final_sweep/screening/screening.json
output/final_sweep/raw/**/log.txt
# Isaac cross-check: only its plots are kept
output/final_sweep_isaac/*
!output/final_sweep_isaac/plots/
# LaTeX build files of the report (the PDF itself is kept)
report/*.aux
report/*.log
report/*.out
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/figures/videos/
